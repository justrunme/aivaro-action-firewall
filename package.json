{
  "name": "justrunme-zero",
  "version": "0.1.0",
  "description": "Rehearse. Run. Recover. The mission simulator and undo engine for Kiro agents.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "justrunme": "src/cli/index.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "test:smoke": "node --test test/smoke.test.js",
    "test:demo": "node --test demo/integration.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "keywords": [
    "kiro",
    "kiroween",
    "mcp",
    "ai-agents",
    "rehearsal",
    "undo",
    "ed25519"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justrunme/justrunme-zero.git"
  },
  "homepage": "https://github.com/justrunme/justrunme-zero#readme",
  "bugs": {
    "url": "https://github.com/justrunme/justrunme-zero/issues"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
